# Browser-visible key: keep blank for checks; restrict allowed APIs and referrers.
NUXT_PUBLIC_GMAPS_API=
# Browser-reachable API base (HTTP and WebSocket); never a container-only hostname.
NUXT_PUBLIC_BACKEND_HOST=http://127.0.0.1:8080
# Private SSR auth API base; blank falls back to the public base above.
NUXT_BACKEND_SERVER_HOST=
# Same-origin reverse proxy example (not enabled here):
# NUXT_PUBLIC_BACKEND_HOST=/api
# NUXT_BACKEND_SERVER_HOST=http://backend:8080
# The proxy must strip /api and forward WebSocket upgrades; backend is an example
# private service name reachable from the Nuxt server, not from the browser.
