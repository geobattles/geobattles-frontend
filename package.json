{
    "name": "geobattles-frontend",
    "private": true,
    "type": "module",
    "packageManager": "npm@11.19.1",
    "engines": {
        "node": ">=24.22.3 <25",
        "npm": ">=11.19.1 <12"
    },
    "scripts": {
        "build": "nuxt build",
        "dev": "nuxt dev --host 127.0.0.1",
        "generate": "nuxt generate",
        "preview": "nuxt preview",
        "postinstall": "nuxt prepare",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "nuxt typecheck",
        "check": "npm run format:check && npm run typecheck && npm run build",
        "test:socket": "node tools/socket-smoke.mjs",
        "test:e2e:match": "bash tools/check-match.sh",
        "test:e2e": "playwright test",
        "test:e2e:keyless": "GEOBATTLES_E2E_MAPS=0 GEOBATTLES_E2E_MAPS_SCOPE=all playwright test",
        "test:e2e:maps:recovery": "GEOBATTLES_E2E_MAPS=1 GEOBATTLES_E2E_MAPS_SCOPE=recovery playwright test --project=maps",
        "test:e2e:maps:multiround": "GEOBATTLES_E2E_MAPS=1 GEOBATTLES_E2E_MAPS_SCOPE=multiround playwright test --project=maps",
        "test:e2e:maps:all": "GEOBATTLES_E2E_MAPS=1 GEOBATTLES_E2E_MAPS_SCOPE=all playwright test --project=maps"
    },
    "devDependencies": {
        "@nuxtjs/tailwindcss": "6.14.0",
        "@playwright/test": "1.65.1",
        "@types/canvas-confetti": "1.9.0",
        "@types/google.maps": "3.58.1",
        "@types/node": "24.19.2",
        "@vite-pwa/nuxt": "1.1.1",
        "nuxt": "4.6.4",
        "prettier": "3.5.2",
        "typescript": "5.9.3",
        "vue-tsc": "3.3.14"
    },
    "dependencies": {
        "canvas-confetti": "1.9.3"
    }
}
